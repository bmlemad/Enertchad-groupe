    },
    {
      "source": "/services/distribution",
      "destination": "/#section-distribution",
      "permanent": true
    },
    {
      "source": "/services/petrochimie",
      "destination": "/#section-petrochimie",
      "permanent": true
    },
    {
      "source": "/services/digital",
      "destination": "/#section-digital",
      "permanent": true
    },
    {
      "source": "/services/ics",
      "destination": "/#section-ics-security",
      "permanent": true
    },
    {
      "source": "/services/cybersecurite",
