{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/services",
      "destination": "/solutions/",
      "permanent": true
    },
    {
      "source": "/explore",
      "destination": "/solutions/",
      "permanent": true
    },
    {
      "source": "/manifeste",
      "destination": "/pourquoi/manifeste.html",
      "permanent": true
    },
    {
      "source": "/positionnement",
      "destination": "/pourquoi/positionnement.html",
      "permanent": true
    },
    {
      "source": "/trajectoire",
      "destination": "/pourquoi/trajectoire.html",
      "permanent": true
    },
    {
      "source": "/equipe",
      "destination": "/pourquoi/equipe.html",
      "permanent": true
    },
    {
      "source": "/atlas",
      "destination": "/data/atlas.html",
      "permanent": true
    },
    {
      "source": "/observatoire",
      "destination": "/data/observatoire.html",
      "permanent": true
    },
    {
      "source": "/oleoduc-3d",
      "destination": "/data/oleoduc-3d.html",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/data/dashboard.html",
      "permanent": true
    },
    {
      "source": "/dashboard-executif",
      "destination": "/data/dashboard.html",
      "permanent": true
    },
    {
      "source": "/investisseurs",
      "destination": "/engagement/investisseurs.html",
      "permanent": true
    },
    {
      "source": "/transparence",
      "destination": "/engagement/transparence.html",
      "permanent": true
    },
    {
      "source": "/presse",
      "destination": "/engagement/presse.html",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/engagement/contact.html",
      "permanent": true
    },
    {
      "source": "/cas-cnpcic",
      "destination": "/operateurs/cnpcic.html",
      "permanent": true
    },
    {
      "source": "/cas-perenco",
      "destination": "/operateurs/perenco.html",
      "permanent": true
    },
    {
      "source": "/cas-sht",
      "destination": "/operateurs/sht.html",
      "permanent": true
    },
    {
      "source": "/cas-cotco-totco",
      "destination": "/operateurs/cotco-totco.html",
      "permanent": true
    },
    {
      "source": "/cas-srn",
      "destination": "/operateurs/srn.html",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/upstream",
      "destination": "/amont/",
      "permanent": true
    },
    {
      "source": "/upstream/(.*)",
      "destination": "/amont/$1",
      "permanent": true
    },
    {
      "source": "/midstream",
      "destination": "/intermediaire/",
      "permanent": true
    },
    {
      "source": "/midstream/(.*)",
      "destination": "/intermediaire/$1",
      "permanent": true
    },
    {
      "source": "/downstream",
      "destination": "/aval/",
      "permanent": true
    },
    {
      "source": "/downstream/(.*)",
      "destination": "/aval/$1",
      "permanent": true
    },
    {
      "source": "/operators",
      "destination": "/operateurs/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}